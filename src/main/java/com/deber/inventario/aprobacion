package com.deber.inventario.aprobacion;

import com.deber.inventario.auditoria.AuditoriaService;
import com.deber.inventario.integracion.EventoAprobada;
import com.deber.inventario.integracion.OutboxService;
import com.deber.inventario.recomendaciones.Recomendacion;
import com.deber.inventario.recomendaciones.RecomendacionRepository;
import com.fasterxml.jackson.core.JsonProcessingException;
import com.fasterxml.jackson.databind.ObjectMapper;
import java.io.UncheckedIOException;
import java.util.NoSuchElementException;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

@Service
public class AprobacionService {

    private final RecomendacionRepository repo;
    private final AuditoriaService auditoria;
    private final OutboxService outbox;
    private final ObjectMapper mapper;

    public AprobacionService(RecomendacionRepository repo, AuditoriaService auditoria,
                             OutboxService outbox, ObjectMapper mapper) {
        this.repo = repo;
        this.auditoria = auditoria;
        this.outbox = outbox;
        this.mapper = mapper;
    }

    /**
     * En una sola transacción: cambia el estado, deja la auditoría y (si se aprueba) encola el evento.
     */
    @Transactional
    public void decidir(long id, boolean aprobar, String usuario) {
        String nuevoEstado = aprobar ? "APROBADA" : "RECHAZADA";
        int filas = repo.cambiarEstadoSiPendiente(id, nuevoEstado, usuario);
        if (filas == 0) {
            repo.buscar(id).orElseThrow(() -> new NoSuchElementException("La recomendación " + id + " no existe"));
            throw new IllegalStateException("La recomendación " + id + " ya fue decidida");
        }
        auditoria.registrar("RECOMENDACION", id, nuevoEstado, usuario, "");

        if (aprobar) {
            Recomendacion r = repo.buscar(id).orElseThrow();
            EventoAprobada evento = new EventoAprobada(r.id(), r.tipo(), r.productoId(),
                    r.bodegaDestinoId(), r.bodegaOrigenId(), r.cantidad(), usuario);
            try {
                outbox.encolar("RecomendacionAprobada", mapper.writeValueAsString(evento));
            } catch (JsonProcessingException e) {
                throw new UncheckedIOException(e);
            }
        }
    }
}
